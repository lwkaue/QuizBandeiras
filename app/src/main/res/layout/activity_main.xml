<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInicioTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Início"
            android:textColor="#F0B767"
            android:textSize="24sp"
            android:fontFamily="sans-serif-round"
            android:textStyle="bold" />

        <!-- CARD PRINCIPAL GLASSMORPHISM (30% opacidade) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#26F4FFE9"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <!-- CARD ALUNO 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#33F4FFE9"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAluno"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/keven"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            android:contentDescription="Foto Kéven" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvNomeAluno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kéven Sousa Miranda"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-round"
                                android:textStyle="bold"
                                android:textColor="#F4FFE9" />

                            <TextView
                                android:id="@+id/tvRgm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RGM: 77743511"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-round"
                                android:textColor="#D0D0D0"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD ALUNO 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#33F4FFE9"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAluno2"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/kaue"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            android:contentDescription="Foto Kauê" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvNomeAluno2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kauê Sousa Miranda"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-round"
                                android:textStyle="bold"
                                android:textColor="#F4FFE9" />

                            <TextView
                                android:id="@+id/tvRgm2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RGM: 44483139"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-round"
                                android:textColor="#D0D0D0"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- CAMPO NOME -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#33F4FFE9"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etNome"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Digite o seu nome..."
                        android:textColorHint="#A0F4FFE9"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@android:color/transparent"
                        android:textColor="#F4FFE9"
                        android:fontFamily="sans-serif-round"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </androidx.cardview.widget.CardView>

                <!-- BOTÕES DOURADOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnIniciar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:enabled="false"
                        android:backgroundTint="#F0B767"
                        android:textColor="#3A0353"
                        android:fontFamily="sans-serif-round"
                        android:text="INICIAR QUIZ"
                        android:textStyle="bold"
                        app:cornerRadius="20dp" />

                    <Button
                        android:id="@+id/btnSair"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="#F0B767"
                        android:textColor="#3A0353"
                        android:fontFamily="sans-serif-round"
                        android:text="SAIR"
                        android:textStyle="bold"
                        app:cornerRadius="20dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>