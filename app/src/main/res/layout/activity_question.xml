<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient"
    tools:context=".QuestionActivity">

    <TextView
        android:id="@+id/tvHeaderQuestion"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Que país é este?"
        android:textColor="#F0B767"
        android:textSize="24sp"
        android:fontFamily="sans-serif-round"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#66000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvProgresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pergunta 1 de 10"
                android:textColor="#F0B767"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-round"
                android:layout_marginBottom="16dp" />

            <!-- BANDEIRA COM BORDA ALINHADA (Sem padding interno) -->
            <ImageView
                android:id="@+id/ivBandeira"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginBottom="20dp"
                android:scaleType="fitXY"
                android:background="@drawable/bg_bandeira_glow"
                android:clipToOutline="true"
                android:contentDescription="Bandeira do país" />

            <RadioGroup
                android:id="@+id/rgOpcoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbOpcao1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_opcao_selector"
                    android:textColor="@color/color_texto_opcao"
                    android:buttonTint="@color/color_texto_opcao"
                    android:fontFamily="sans-serif-round"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbOpcao2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_opcao_selector"
                    android:textColor="@color/color_texto_opcao"
                    android:buttonTint="@color/color_texto_opcao"
                    android:fontFamily="sans-serif-round"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbOpcao3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_opcao_selector"
                    android:textColor="@color/color_texto_opcao"
                    android:buttonTint="@color/color_texto_opcao"
                    android:fontFamily="sans-serif-round"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbOpcao4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_opcao_selector"
                    android:textColor="@color/color_texto_opcao"
                    android:buttonTint="@color/color_texto_opcao"
                    android:fontFamily="sans-serif-round"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnResponder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:enabled="false"
                android:backgroundTint="#F0B767"
                android:textColor="#3A0353"
                android:fontFamily="sans-serif-round"
                android:text="RESPONDER"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>